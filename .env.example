# ── Zügli — Umgebungsvariablen ───────────────────────────────────────────
# Kopieren nach .env.local (Next.js lädt .env.local automatisch):
#   PowerShell:  copy .env.example .env.local
#   Git Bash:    cp .env.example .env.local

# ── Pflicht ──────────────────────────────────────────────────────────────
# Mistral API Key — https://console.mistral.ai/api-keys
# Europäisches Modell (Mistral Small), EU-Datenhaltung, günstig.
MISTRAL_API_KEY=

# Modell (optional, Default: mistral-small-latest)
# Alternativen: ministral-8b-latest (günstiger), mistral-medium-latest (besser)
MISTRAL_MODEL=mistral-small-latest

# Open Data Plattform Mobilität Schweiz — kostenloser API-Key:
# https://api-manager.opentransportdata.swiss/  (OJP 2.0 abonnieren)
# Gratis-Tier: 50 Requests/Minute, 20'000/Tag — reicht dank Caching locker.
# Ohne Key laufen Chat und UI, aber alle Bahn-Tools melden einen Hinweis.
OTD_API_KEY=

# ── Optional: separate Keys je API-Produkt (Fallback: OTD_API_KEY) ───────
# Wagenreihung ("Train Formation Service") und Störungen ("SIRI-SX") sind
# eigene API-Produkte im API-Manager — je nach Abo braucht es eigene Keys.
# ACHTUNG SIRI-SX: Das Abo erlaubt nur 48 Abfragen/Tag — die App fetcht den
# Feed deshalb höchstens alle 30 Min (geteilter Cache + Tageszähler).
OTD_FORMATION_KEY=
OTD_SIRI_SX_KEY=

# Preisauskunft (OJP Fare, BETA/Integrationssystem, Preise unverbindlich):
# im API-Manager das Produkt "OJP Fare" abonnieren und den Key hier eintragen
# (Fallback: OTD_API_KEY). Endpoint-Default: https://api.opentransportdata.swiss/ojpfare/
OTD_FARE_KEY=
# OTD_FARE_ENDPOINT=  (nur für abweichende Umgebungen)

# Soft-Selbstlimit unter der 20k-Tagesquote (Upstream-Requests/Tag)
OTD_DAILY_CAP=18000

# Import-Crons (siehe vercel.json → crons: Belegung, Haltestellen, Störungen)
# legen kompakte Blobs in den geteilten Cache (Vercel Runtime Cache, optional
# Redis). Auf Vercel schützt CRON_SECRET die Routen /api/cron/* (Vercel setzt
# den Header automatisch).
CRON_SECRET=

# ── Optional: Upstash Redis (exakte Rate-Limits + geteilter Cache) ──
# Vercel Marketplace → Upstash Redis. Die Integration setzt KV_REST_API_URL /
# KV_REST_API_TOKEN automatisch; alternativ die UPSTASH_-Namen unten.
# Ohne Redis (oder wenn Redis gesperrt/nicht erreichbar ist) läuft alles
# weiter: geteilter Cache und Rate-Limit-Zähler über den Vercel Runtime Cache
# (instanzübergreifend, auf ein, zwei Nachrichten genau), lokal In-Memory.
# Die Live-Karte braucht kein Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tages-Cap an Nachrichten für die öffentliche Demo (Kostenschutz)
DAILY_MESSAGE_CAP=1500

# Nachrichten pro IP je 5-Minuten-Fenster
RATE_LIMIT_PER_IP=10

# ── Optional: Betreiber-Angaben (Impressum + Datenschutz) ──
# Ohne diese Werte werden die Impressum-/Datenschutz-Links ausgeblendet und die
# /datenschutz-Seite zeigt einen Platzhalter. Wer die App selbst betreibt, trägt
# hier die eigenen Angaben ein (die im Repo veröffentlichte Version bleibt generisch).
OWNER_NAME=
OWNER_ADDRESS=
OWNER_IMPRINT_URL=
# Optional; ohne Angabe wird OWNER_IMPRINT_URL als Kontakt genutzt.
OWNER_CONTACT_URL=
