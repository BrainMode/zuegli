{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/occupancy",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/stops",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/livemap",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/disruptions",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/disruptions-unplanned",
      "schedule": "*/2 * * * *"
    }
  ]
}
